{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-peptide-bench",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // D1 orders store. Create it, paste the id, uncomment, then apply migrations:
  //   npx wrangler d1 create peptide-store-orders
  //   npx wrangler d1 migrations apply peptide-store-orders --remote
  // Until this is bound, /api/orders falls back to console.log.
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "peptide-store-orders",
  //     "database_id": "<paste id from `wrangler d1 create`>",
  //     "migrations_dir": "migrations"
  //   }
  // ]
}
